{
  "name": "veeam-telegram-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS service that watches the Veeam Backup & Replication REST API and reports changes to Telegram forum topics",
  "scripts": {
    "test": "npm run build && node test/run.cjs",
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "axios": "^1.7.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.4",
    "typescript": "^5.7.2"
  },
  "//": [
    "overrides: fixed versions of packages NestJS 10 pins with known advisories.",
    "Nest 12 carries them itself but is ESM-only; drop these on moving to it."
  ],
  "overrides": {
    "body-parser": "1.20.8",
    "file-type": "21.3.4",
    "js-yaml": "4.3.2",
    "lodash": "4.18.1",
    "multer": "2.4.0",
    "qs": "6.16.0"
  },
  "license": "UNLICENSED"
}
