    {
      "id": 7,
      "type": "table",
      "title": "Задания с ошибкой или предупреждением",
      "description": "Последний результат каждого такого задания и когда оно запускалось. Задание, которое сейчас идёт, сюда не попадает: Veeam очищает его результат до конца запуска.",
      "datasource": {
        "type": "prometheus",
        "uid": "veeam-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veeam-prometheus"
          },
          "refId": "A",
          "expr": "(veeam_job_last_result{server=~\"$server\"} >= 1) + 0",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veeam-prometheus"
          },
          "refId": "B",
          "expr": "veeam_job_last_run_timestamp_seconds{server=~\"$server\"} * 1000 and on (server, job_id) (veeam_job_last_result{server=~\"$server\"} >= 1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veeam-prometheus"
          },
          "refId": "C",
          "expr": "veeam_job_next_run_timestamp_seconds{server=~\"$server\"} * 1000 and on (server, job_id) (veeam_job_last_result{server=~\"$server\"} >= 1)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "job_id": true,
              "repository_id": true
            },
            "indexByName": {
              "server": 0,
              "job_name": 1,
              "job_type": 2,
              "Value #A": 3,
              "Value #B": 4,
              "Value #C": 5
            },
            "renameByName": {
              "server": "Сервер",
              "job_name": "Задание",
              "job_type": "Тип",
              "Value #A": "Результат",
              "Value #B": "Последний запуск",
              "Value #C": "Следующий запуск"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Результат",
                "desc": true
              },
              {
                "field": "Последний запуск",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
