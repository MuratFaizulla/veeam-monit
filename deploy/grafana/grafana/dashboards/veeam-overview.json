    {
      "id": 8,
      "type": "bargauge",
      "title": "Заполненность репозиториев",
      "description": "Сколько места занято, самые полные сверху. Жёлтый — от 80 %, красный — от 90 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "veeam-prometheus"
