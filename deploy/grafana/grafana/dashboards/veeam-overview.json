      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "veeam-prometheus"
          },
          "refId": "A",
          "expr": "sort_desc(100 * veeam_repository_used_bytes{server=~\"$server\"} / veeam_repository_capacity_bytes{server=~\"$server\"})",
          "legendFormat": "{{repository}} · {{server}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 80,
                "color": "orange"
              },
              {
                "value": 90,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
