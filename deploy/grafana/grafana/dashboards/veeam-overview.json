      {
        "name": "server",
        "label": "Сервер",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "veeam-prometheus"
        },
        "query": {
          "query": "label_values(veeam_server_up, server)",
          "refId": "server"
        },
        "definition": "label_values(veeam_server_up, server)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
