# --- HTTP server ---
PORT=3000
# Serve the OpenAPI page at /api/docs. Keep it off unless operators need it.
API_DOCS=false

# --- Veeam Backup & Replication REST API ---
# Every server the bot watches, comma-separated. Each entry is `name=url`, or a
# bare URL named after its host (veeam01 below). Alerts come from all of
# them; the live topics, /digest and /job show the one selected with /servers,
# the first until somebody picks another. The name is what the menu and the
# alerts say, and renaming a server makes the bot learn its jobs again, quietly.
VEEAM_SERVERS=https://veeam01.example.com:9419,https://veeam02.example.com:9419
# The one-server way to say the same thing, from before there was a list. Set
# this or VEEAM_SERVERS, not both.
# VEEAM_BASE_URL=https://veeam01.example.com:9419
# Servers that complete a TLS handshake only when it offers SHA-1 signatures —
# an old Windows build that resets the connection (ECONNRESET) otherwise.
# Comma-separated names from VEEAM_SERVERS. Weakens TLS for those servers only;
# the lasting fix is enabling modern TLS 1.2 on the server itself.
VEEAM_LEGACY_TLS=veeam02
# Shared by every server: one TLS policy, one monitor account (a server outside
# the domain may have its own; see VEEAM_MONITOR_USERNAME below).
# Value sent in the mandatory x-api-version header. A server on an older Veeam
# build refuses it and names the versions it speaks; that server is then spoken
# to in the newest of them, and the log says so once.
VEEAM_API_VERSION=1.2-rev1
# VBR ships with a self-signed certificate named "Veeam Backup Server
# Certificate", with no host name in it, so no CA bundle can vouch for it. Pin
# it instead: name=path per server, the file being the PEM certificate the
# server presents (in Docker, ./certs is mounted as /app/certs). A pinned
# server is trusted by exactly that certificate, whatever VEEAM_INSECURE_TLS says.
#   openssl s_client -connect host:9419 </dev/null | openssl x509 > certs/name.pem
# (with -cipher DEFAULT@SECLEVEL=0 for a server named in VEEAM_LEGACY_TLS)
VEEAM_TLS_CERTS=
# Turns verification off for every server not pinned above; temporary only.
VEEAM_INSECURE_TLS=false
VEEAM_TIMEOUT_MS=30000


# Where the service writes its log (default: logs/backend.log next to package.json)
# LOG_FILE=C:\path\to\backend.log

# --- Docker only ---
# A published image to run instead of building one from this checkout, e.g.
# ghcr.io/muratfaizulla/veeam-monit:1 (every 1.x release). Then:
#   docker compose pull && docker compose up -d --no-build
# MONITOR_IMAGE=
# Host port published by docker-compose; the container always listens on 3000.
# Bind to loopback by default. Set HOST_BIND=0.0.0.0 only behind a firewall or reverse proxy.
# HOST_BIND=127.0.0.1
# HOST_PORT=3000
# Container clock, read when TELEGRAM_TIMEZONE is empty.
# TZ=Asia/Qyzylorda

# --- Telegram notifications ---
# Create a fresh token with BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=
# Optional public HTTPS origin. Leave empty to use domain-free long polling.
TELEGRAM_WEBHOOK_URL=
# Both at least 32 characters when set; make one with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Empty closes the operator endpoints to everybody.
TELEGRAM_ADMIN_KEY=
# Comma-separated chat IDs, for example: -1001234567890
TELEGRAM_CHAT_IDS=
# Set to 0 to disable periodic Veeam checks.
TELEGRAM_MONITOR_INTERVAL_MS=60000

# --- Notification routing ---
# Where each alert lands inside a forum supergroup (a group with topics):
#   single   - alerts go to General; the live status topics are unaffected (default)
#   job      - one topic per Veeam job, everything else by category
#   severity - one topic per severity
#   kind     - one topic per category (jobs share a single topic)
TELEGRAM_ROUTING_MODE=single
# Optional prefix for auto-created per-job topics, e.g. "Veeam / ".
TELEGRAM_JOB_TOPIC_PREFIX=
# The bot needs the "Manage topics" right to create missing topics. Set to
# false to only use topics it already knows; alerts then fall back to General.
TELEGRAM_CREATE_TOPICS=true
# In single mode critical and warning events go here; other events stay in General.
TELEGRAM_TOPIC_ALERTS=🚨 Alerts
# Topic names per category and per severity. Names are in English so they read
# the same as the Veeam job names they sit next to; the message bodies stay in
# Russian. Topics are matched by name, so renaming one here creates a new topic
# rather than renaming the old one.
TELEGRAM_TOPIC_JOBS=📦 Jobs
TELEGRAM_TOPIC_INFRASTRUCTURE=🖥 Infrastructure
TELEGRAM_TOPIC_REPOSITORY=💾 Repositories
TELEGRAM_TOPIC_SECURITY=🛡 Security
TELEGRAM_TOPIC_DIGEST=📊 Daily digest
TELEGRAM_TOPIC_MANUAL=📣 Announcements
TELEGRAM_TOPIC_CRITICAL=🔴 Errors
TELEGRAM_TOPIC_WARNING=🟡 Warnings
TELEGRAM_TOPIC_SUCCESS=🟢 Recovered
TELEGRAM_TOPIC_INFO=ℹ️ Events
# Live status. Each of these topics holds exactly one message, edited in place
# rather than appended to: is the monitor working, what is running right now,
# what is still scheduled for today, throughput, repository capacity, and what
# is not actually protected.
# Set TELEGRAM_LIVE=false to not maintain them at all; the bot then deletes the
# messages it left in them.
TELEGRAM_LIVE=true
TELEGRAM_TOPIC_HEALTH=🩺 Monitor health
TELEGRAM_TOPIC_RUNNING=▶️ Running now
TELEGRAM_TOPIC_SCHEDULE=📅 Upcoming runs
TELEGRAM_TOPIC_PERFORMANCE=📈 Performance
# Existing topic's message_thread_id. Leave 0/empty to let the bot create it.
TELEGRAM_PERFORMANCE_TOPIC_ID=
TELEGRAM_TOPIC_REPOSITORIES_LIVE=💾 Repositories
# Existing Repositories topic's message_thread_id. Empty lets the bot create it.
TELEGRAM_REPOSITORIES_TOPIC_ID=
TELEGRAM_TOPIC_PROTECTION=🛡 Protection
# Backup chains whose job no longer exists. Same scan again; no extra requests.
# Off by default: on this estate it is 245 chains, and the list is only worth
# publishing once somebody is going to go through them. Set to true to bring the
# topic back — it is re-created automatically. Set back to false, the bot deletes
# the message it left there.
TELEGRAM_LIVE_ORPHANS=false
TELEGRAM_TOPIC_ORPHANS=🧹 Orphaned backups
# The protection scan reads every restore point in the estate (~20 requests,
# several seconds), and the age of a backup changes by the hour, not by the
# minute — so it runs on its own slow cadence. Only the server shown in the
# topics is scanned; switching to another one scans it at once, unless it was
# scanned in the last ten minutes, so a long cadence never shows stale data
# after a switch.
TELEGRAM_PROTECTION_INTERVAL_MIN=60
# A job is reported when its newest restore point is older than both this floor
# and OVERDUE_FACTOR times the job's own usual interval. The second half is what
# keeps a weekly job from being reported three days after it ran.
# Disabled jobs, and jobs set to run manually, are left out of this check
# entirely — they are not supposed to be producing restore points. The message
# says how many were excluded.
TELEGRAM_PROTECTION_STALE_DAYS=3
TELEGRAM_PROTECTION_OVERDUE_FACTOR=2.5
# Consecutive failed RUNS that put a job on the list on their own, even when it
# still has a fresh restore point. Runs, not sessions: Veeam retries a failed
# job automatically and each retry is its own session, so with the default
# three retries one failed run looks like four failures unless they are folded.
TELEGRAM_PROTECTION_FAILURE_STREAK=3
# An unchanged live message is rewritten at least this often, so a frozen
# "Обновлено" (updated) time is evidence the monitor itself stopped.
TELEGRAM_LIVE_REFRESH_MIN=5
# IANA zone for the times shown to humans. Empty means the server's own zone.
TELEGRAM_TIMEZONE=
# Severities that are delivered at all. Drop "success" to mute recoveries.
TELEGRAM_SEVERITIES=critical,warning,success,info
# Optional JSON file with explicit rules; see telegram-routes.example.json.
TELEGRAM_ROUTES_FILE=

# --- Delivery and noise control ---
# Minimum gap between two messages to the same chat, in milliseconds.
TELEGRAM_SEND_INTERVAL_MS=1500
# Messages buffered per chat before the oldest is dropped.
TELEGRAM_QUEUE_LIMIT=200
# Repeat windows, in minutes, for conditions that persist.
TELEGRAM_JOB_COOLDOWN_MIN=15
TELEGRAM_AUTH_COOLDOWN_MIN=60
TELEGRAM_REPOSITORY_COOLDOWN_MIN=720
# Free space below this percentage raises a repository alert. 0 disables it.
TELEGRAM_REPOSITORY_FREE_PERCENT=10
# Local hour (0-23) for the daily summary, or -1 to disable it.
TELEGRAM_DIGEST_HOUR=-1
# Chats, topics, job results and cooldowns survive a restart here.
# TELEGRAM_STATE_FILE=C:\path\to\telegram-state.json

# Dedicated Veeam service account used only by the background Telegram monitor.
# Recommended role: Veeam Backup Viewer. Do not use a personal administrator.
VEEAM_MONITOR_USERNAME=
VEEAM_MONITOR_PASSWORD=
# A server outside the domain cannot take the account above: give it a local
# account of its own. The variables end in the server's name in capitals, with
# "_" for "-" (veeam-dc2 below). Every server not named this way uses the
# account above.
# VEEAM_MONITOR_USERNAME_VEEAM_DC2=VEEAM-DC2\veeam-monitor
# VEEAM_MONITOR_PASSWORD_VEEAM_DC2=
