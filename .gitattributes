# Every text file is stored and checked out with LF, on Windows too. The
# repository already holds LF; this ends the "LF will be replaced by CRLF"
# warnings and the chance of a file committed with CRLF.
* text=auto eol=lf

*.svg text

# The vendor's API spec is reference material, not code of this project.
docs/veeam-openapi.json linguist-documentation

# The tests are plain JavaScript on purpose: they run the compiled service,
# the code that ships. Left out of GitHub's language bar, which is meant to
# say what the service is written in.
test/** linguist-detectable=false
